{
  "schema_version": 1,
  "description": "VT340 regression and evidence-test catalog",
  "suites": {
    "quick": "Short structural and firmware-free checks",
    "core": "Primary confidence suite for emulator development",
    "device": "Firmware-free extracted-device tests",
    "startup": "Firmware boot, POST, and interprocessor tests",
    "graphics": "Text, raster, Set-Up, color, and SIXEL behavior",
    "conformance": "External hardware-observed VT340 behavior corpus",
    "gallery": "Tracked screenshots, animations, and provenance",
    "serial": "Serial device and connector diagnostics",
    "persistence": "Configuration and nonvolatile storage",
    "historical": "Sprint closeout and compatibility evidence",
    "all": "All atomic tests; aliases and aggregate wrappers are excluded"
  },
  "tests": [
    {
