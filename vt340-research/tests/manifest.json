    {
      "id": "dc323-device",
      "script": "dc323-device.sh",
      "title": "Firmware-free DC323 device regression",
      "kind": "atomic",
      "suites": ["quick", "core", "device", "graphics"],
      "estimated_seconds": 15,
      "requires_roms": false,
      "accepts_binary": false,
      "requires": ["make", "rg"],
      "fixtures": [],
      "dc323_commands": [
        {"family": "command.abort", "level": "direct", "scope": "Aborts an active diagnostic transfer and asserts completed idle status."},
        {"family": "viper.register-load", "level": "direct", "scope": "Loads independent per-plane Viper registers and verifies retained values and color indices."},
        {"family": "raster.normal-constant", "level": "direct", "scope": "Checks constant fills, masks, clipping, signed vectors, scaling, and Bresenham pixels."},
        {"family": "raster.normal-bitmap", "level": "direct", "scope": "Checks bitmap copies, overlap behavior, and 1:20 Set-Up restoration scaling."},
        {"family": "raster.normal-hole-fill", "level": "direct", "scope": "Compares rotated broad vectors with hole filling off and on at exact interior pixels."},
        {"family": "raster.normal-indexed", "level": "direct", "scope": "Checks source/destination indexing, signed offsets, frame rollover, and old/new selection above and below the live raster boundary."},
        {"family": "raster.error-offsets", "level": "direct", "scope": "Checks signed ERR1/ERR2 shifts on destination fast and slow vectors and independent fill edges A and B."},
        {"family": "raster.source2", "level": "direct", "scope": "Checks source-2 copies, indexing independence, tiling, patterned fills, dual-source internal routing through both CSR banks, cross-plane I/D-bus broadcast, and linear-pattern routing."},
        {"family": "raster.destination-disabled", "level": "direct", "scope": "Verifies an operation-2 command with destination disabled leaves the target unchanged."},
        {"family": "raster.reserved-mode", "level": "direct", "scope": "Verifies X-control mode 01 produces no drawing."},
        {"family": "raster.linear-source1", "level": "direct", "scope": "Checks rotation, fast up/down scaling, retained slow position and fractional phase, pen-up advancement, origin reset, and raster-phase indexing."},
        {"family": "raster.linear-constant", "level": "direct", "scope": "Verifies the undocumented source-free linear-pattern encoding does not invent visible output."},
        {"family": "raster.fill-two-edge", "level": "direct", "scope": "Checks X-fill and Y-fill interiors, exteriors, and excluded endpoints."},
        {"family": "raster.fill-baseline", "level": "direct", "scope": "Checks sloped X and Y edges against fixed baselines."},
        {"family": "raster.fill-chained", "level": "direct", "scope": "Checks X/Y diamonds, explicit restart, unequal edge expiration with one-sided reload, and scan reversal after crossing."},
        {"family": "transfer.bitmap-to-processor-x", "level": "direct", "scope": "Checks selected-plane packing, six-entry FIFO prefetch/drain, I/D readback, and completion status."},
        {"family": "transfer.processor-to-bitmap-x", "level": "direct", "scope": "Checks aligned/unaligned writes, masks, CSR routing, six-word back-pressure, cancel, and asynchronous status."},
        {"family": "transfer.z-mode", "level": "direct", "scope": "Checks plane-addressed PTB unpacking and BTP packing for two adjacent pixels in a Z block."},
        {"family": "scroll.frame-service", "level": "direct", "scope": "Checks deferred up/down scroll, erase, edge masks, offsets, and pending-command replacement."}
      ],
      "outputs": ["source2-tiled-polygon-fill.png", "source2-untiled-baseline-fill.png"]
    },
